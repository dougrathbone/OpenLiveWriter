<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>OpenLiveWriter.BlogClient</AssemblyName>
    <RootNamespace>OpenLiveWriter.BlogClient</RootNamespace>
    <ProjectGuid>{FE2EA529-26E6-42C3-9F6A-E58966995FFE}</ProjectGuid>
    <!-- Suppress obsolete warnings during migration -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\GlobalAssemblyInfo.cs" Link="GlobalAssemblyInfo.cs" />
  </ItemGroup>

  <!-- Embedded Resources - images -->
  <ItemGroup>
    <EmbeddedResource Include="**\Images\*.png" />
    <EmbeddedResource Include="**\Images\*.gif" />
  </ItemGroup>

  <!-- Embedded Resources - configuration files -->
  <ItemGroup>
    <EmbeddedResource Include="Clients\PassportSettings.xml" />
    <EmbeddedResource Include="Clients\GoogleBloggerv3Secrets.json" />
    <EmbeddedResource Include="Providers\BlogProvidersB5.xml" />
    <EmbeddedResource Include="ImageViewers\DhtmlImageViewers.xml" />
  </ItemGroup>

  <!-- NuGet Package References -->
  <ItemGroup>
    <PackageReference Include="Google.Apis" />
    <PackageReference Include="Google.Apis.Auth" />
    <PackageReference Include="Google.Apis.Blogger.v3" />
    <PackageReference Include="Google.Apis.Core" />
    <PackageReference Include="Google.Apis.Drive.v3" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Zlib.Portable.Signed" />
  </ItemGroup>

  <!-- Project References -->
  <ItemGroup>
    <ProjectReference Include="..\OpenLiveWriter.Api\OpenLiveWriter.Api.csproj" />
    <ProjectReference Include="..\OpenLiveWriter.BrowserControl\OpenLiveWriter.BrowserControl.csproj" />
    <ProjectReference Include="..\OpenLiveWriter.Controls\OpenLiveWriter.Controls.csproj" />
    <ProjectReference Include="..\OpenLiveWriter.CoreServices\OpenLiveWriter.CoreServices.csproj" />
    <ProjectReference Include="..\OpenLiveWriter.Extensibility\OpenLiveWriter.Extensibility.csproj" />
    <ProjectReference Include="..\OpenLiveWriter.HtmlParser\OpenLiveWriter.HtmlParser.csproj" />
    <ProjectReference Include="..\OpenLiveWriter.Interop\OpenLiveWriter.Interop.csproj" />
    <ProjectReference Include="..\OpenLiveWriter.Localization\OpenLiveWriter.Localization.csproj" />
  </ItemGroup>

  <!-- Generate Blogger API client secrets at build time, before resources
       are embedded. AppVeyor set OlwBloggerClientId / OlwBloggerClientSecret
       as environment variables (MSBuild imports env vars as properties of the
       same name). GitHub Actions uses OLW_BLOGGER_CLIENT_ID / SECRET. An empty
       pre-written secrets file used to win over this target and ship a blank
       client_id, which Google reports as "Missing required parameter: client_id". -->
  <PropertyGroup>
    <BloggerClientSecretsJson>$(MSBuildProjectDirectory)\Clients\GoogleBloggerv3Secrets.json</BloggerClientSecretsJson>
    <OlwBloggerClientId Condition="'$(OlwBloggerClientId)' == '' And '$(OLW_BLOGGER_CLIENT_ID)' != ''">$(OLW_BLOGGER_CLIENT_ID)</OlwBloggerClientId>
    <OlwBloggerClientSecret Condition="'$(OlwBloggerClientSecret)' == '' And '$(OLW_BLOGGER_CLIENT_SECRET)' != ''">$(OLW_BLOGGER_CLIENT_SECRET)</OlwBloggerClientSecret>
    <OlwBloggerClientId Condition="'$(OlwBloggerClientId)' == ''">PASTE_YOUR_CLIENT_ID_HERE</OlwBloggerClientId>
    <OlwBloggerClientSecret Condition="'$(OlwBloggerClientSecret)' == ''">PASTE_YOUR_CLIENT_SECRET_HERE</OlwBloggerClientSecret>
  </PropertyGroup>

  <Target Name="GenerateBloggerClientSecrets" BeforeTargets="PrepareForBuild">
    <!-- Only synthesize the file when it is missing. A developer-authored
         GoogleBloggerv3Secrets.json (see the Connecting to Blogger doc) and a
         CI-written file with real credentials must not be overwritten with
         placeholders. Never write an empty client_id: the defaults above are
         placeholders, not blank strings. -->
    <WriteLinesToFile Condition="!Exists('$(BloggerClientSecretsJson)')"
                     File="$(BloggerClientSecretsJson)"
                     Lines="{ &quot;installed&quot;: { &quot;client_id&quot;: &quot;$(OlwBloggerClientId)&quot;, &quot;client_secret&quot;: &quot;$(OlwBloggerClientSecret)&quot; } }"
                     Overwrite="true" />
  </Target>

</Project>
